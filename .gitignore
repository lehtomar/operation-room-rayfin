# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr
*.tsbuildinfo
.vite

# Test coverage
coverage

# Local env files (`*.local` matches `.env.local`, `.env.*.local`, etc.)
*.local

# Rayfin — auto-generated or secret-bearing files
# `rayfin/.env*` covers .env, .env.bak (emitted by env-file v2 migration with
# secrets), and any future .env-family files Rayfin's runtime adds.
rayfin/.env*
rayfin/.deployments.json
rayfin/.temp/

# Large source geodata (kept local, not committed)
mml-data/

# Secret-bearing local config (e.g. MML WMTS API key)
config/*.local.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Generated frontend assets (regenerated by scripts/sync-assets.mjs)
public/data/

# Scratch output from tooling experiments
.scratch/

# Editor / OS
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
